# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Webhook para envio automático de Leads (Make.com, n8n, Zapier, Notion, Google Sheets)
# Compatível com Vite (VITE_) e Next.js (NEXT_PUBLIC_)
VITE_WEBHOOK_URL=""
NEXT_PUBLIC_WEBHOOK_URL=""

# Número Oficial do WhatsApp para conversões (formato internacional sem + ou espaços)
# Padrão de Moçambique: 258865000777
VITE_WHATSAPP_NUMBER="258865000777"
NEXT_PUBLIC_WHATSAPP_NUMBER="258865000777"

# Meta Pixel (Facebook & Instagram Ads) - Opcional
VITE_META_PIXEL_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Google Analytics 4 (GA4 Measurement ID ex.: G-XXXXXXX) - Opcional
VITE_GA4_ID=""
NEXT_PUBLIC_GA4_ID=""
